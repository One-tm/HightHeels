---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
  robots?: string;
  keywords?: string[];
}

const {
  title,
  description,
  canonicalPath = "/",
  structuredData,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  keywords = [],
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Heels Please" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <!-- Yandex.Metrika counter -->
    <script is:inline type="text/javascript">
      (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=113264514', 'ym');

      ym(113264514, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/113264514" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <a class="skip-link" href="#content">Перейти к содержимому</a>
    <slot />
    <script>
      import { trackGoal } from "../scripts/analytics";
      document.addEventListener("click", event => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLElement>("[data-goal]");
        if (link?.dataset.goal) trackGoal(link.dataset.goal);
      });
    </script>
  </body>
</html>
