---
import { Image } from "astro:assets";
import type { Brand } from "../data/brands";

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
---

<article class="brand-card" id={brand.slug}>
  <div class="brand-card__media">
    <Image
      src={brand.image}
      alt={brand.imageAlt}
      widths={[480, 720, 960]}
      sizes="(max-width: 760px) 100vw, 50vw"
      loading="lazy"
      format="webp"
    />
    <span class="brand-card__index">{brand.index}</span>
  </div>
  <div class="brand-card__body">
    <p class="eyebrow">Official selection</p>
    <h3>{brand.name}</h3>
    <p>{brand.summary}</p>
    <ul aria-label={`Категории ${brand.name}`}>
      {brand.highlights.map((item) => <li>{item}</li>)}
    </ul>
    <div class="brand-card__links">
      <a class="button brand-picker" href={`/catalog/?brand=${brand.slug === "hella-heels" ? "hella" : brand.slug}`} data-goal="picker_entry">Подобрать {brand.name}</a>
      <a class="text-link" href={brand.officialUrl} target="_blank" rel="noreferrer">Открыть сайт бренда</a>
      <a class="muted-link" href={brand.sizeGuideUrl} target="_blank" rel="noreferrer">Таблица размеров</a>
    </div>
  </div>
</article>
