---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { catalogBrands, options, fieldTitles, type FilterName } from "../data/catalog";
const title = "Подбор стрипов: тройки, четвёрки, пятёрки | Heels Please";
const description = "Выберите бренд, тип и высоту стрипов: тройки, четвёрки или пятёрки. Официальные каталоги и готовый запрос для подбора модели, размера и доставки.";
const structuredData = { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: "https://heelsplease.ru/catalog/", inLanguage: "ru-RU" };
const primary: FilterName[] = ["brand", "type", "height", "size"];
const secondary: FilterName[] = ["color", "material", "fit", "toe"];
---
<BaseLayout title={title} description={description} canonicalPath="/catalog/" structuredData={structuredData}>
  <Header compact />
  <main id="content" class="catalog-page">
    <header class="catalog-hero">
      <div><p class="eyebrow">Твоя пара начинается с пожеланий</p><h1>Подбери пару<br /><em>по параметрам</em></h1></div>
      <p>Тройки, четвёрки или пятёрки? Выбери, что хочется. Получишь ссылки на официальные каталоги и готовое сообщение для подбора модели и размера.</p>
    </header>
    <section class="catalog-workspace" aria-labelledby="filters-title">
      <form class="catalog-filters ym-disable-submit" id="catalog-filters">
        <div class="catalog-filters__top"><div><p class="eyebrow">Шаг 1</p><h2 id="filters-title">Твои пожелания</h2></div><button type="reset" class="catalog-reset">Сбросить</button></div>
        <div class="catalog-filter-grid">
          {primary.map(key => <label><span>{fieldTitles[key]}</span><select name={key}><option value="">{key === "brand" ? "Все бренды" : key === "size" ? "Не выбран" : "Не важно"}</option>{Object.entries(options[key]).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>)}
        </div>
        <p class="catalog-filter-note" id="height-help">Тройки ≈ 20 см, четвёрки ≈ 23 см, пятёрки ≈ 25 см — это высота каблука. Высота платформы зависит от модели.</p>
        <a class="button catalog-show-results" href="#catalog-results">Перейти к результату ↓</a>
        <details class="catalog-extra" id="additional-filters"><summary>Дополнительные параметры</summary><div class="catalog-filter-grid">
          {secondary.map(key => <label><span>{fieldTitles[key]}</span><select name={key}><option value="">Не важно</option>{Object.entries(options[key]).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>)}
        </div><p class="catalog-filter-note">Если выбран «Другой» цвет, опиши его в комментарии ниже.</p></details>
        <details class="catalog-extra" id="size-help"><summary>Не знаешь размер?</summary><p>Измерь обе стопы стоя на листе бумаги — от пятки до самого длинного пальца. Укажи больший результат в сантиметрах. Посадку сверим по конкретной модели.</p><div class="size-guide-links"><a href="/sizes/" target="_blank" rel="noreferrer">Размеры Pleaser по линейкам и советы по посадке ↗</a>{catalogBrands.map(brand => <a href={brand.sizeGuideUrl} target="_blank" rel="noreferrer">Официальная таблица {brand.name} ↗</a>)}</div></details>
        <div class="catalog-details ym-hide-content">
          <p class="eyebrow">Можно заполнить сейчас</p>
          <label><span>Длина стопы, см</span><input class="ym-disable-keys" name="foot" inputmode="decimal" placeholder="Например, 24,5" maxlength="20" autocomplete="off" /></label>
          <label><span>Город доставки</span><input class="ym-disable-keys" name="city" placeholder="Например, Москва" maxlength="120" autocomplete="off" /></label>
          <label><span>Уже нашла модель?</span><input class="ym-disable-keys" name="model" placeholder="Ссылка или артикул" maxlength="500" autocomplete="off" /></label>
          <label><span>Комментарий</span><textarea class="ym-disable-keys" name="comment" rows="3" maxlength="1000" placeholder="Цвет, привычный размер, особенности стопы…"></textarea></label>
        </div>
        <p class="catalog-filter-note">Поля необязательные. Текст остаётся на этой странице, пока ты сама не отправишь его в Telegram. <a href="/site-privacy/">Подробнее</a></p>
        <noscript><p>Для сборки запроса включи JavaScript. Официальные каталоги и таблицы размеров доступны по ссылкам.</p></noscript>
      </form>
      <section class="catalog-results" id="catalog-results" aria-labelledby="results-title">
        <div class="catalog-results__heading"><div><p class="eyebrow">Шаг 2</p><h2 id="results-title">Каталоги брендов</h2></div><p id="result-count" aria-live="polite">3 каталога</p></div>
        <p class="catalog-results__intro">Это переходы к брендам, а не список найденных товаров. Все пожелания попадут в запрос; для каждой ссылки ниже указано, что она учитывает.</p>
        <div class="catalog-selection" id="catalog-selection"><span>Параметры пока не выбраны</span></div>
        <div class="catalog-results__list">{catalogBrands.map((brand, index) => <article class="catalog-result" data-brand={brand.id}>
          <span class="catalog-result__index">{String(index + 1).padStart(2, "0")}</span>
          <div class="catalog-result__copy"><h3>{brand.name}</h3><p>{brand.description}</p><p class="catalog-result__source">Цены и наличие проверяются у бренда и перед заказом.</p><div class="catalog-route-note" data-route-note>Открывается общий каталог бренда.</div></div>
          <a class="catalog-result__link" href={brand.officialUrl} data-catalog-link data-goal="catalog_open" target="_blank" rel="noreferrer">Открыть каталог <span aria-hidden="true">↗</span></a>
        </article>)}</div>
        <aside class="catalog-request" id="catalog-request" aria-labelledby="request-title">
          <div><p class="eyebrow">Шаг 3</p><h2 id="request-title">Готовый запрос</h2><p>Скопируй сообщение, открой группу и вставь текст. Поможем проверить размер и модель, рассчитаем итоговую стоимость и срок доставки до подтверждения заказа.</p></div>
          <div class="catalog-request__message"><pre class="ym-hide-content" id="catalog-request-text" tabindex="0">Здравствуйте! Хочу подобрать обувь. Подскажите подходящие варианты.</pre><button type="button" class="copy-button" id="copy-catalog-request" hidden><span>Скопировать запрос</span><span aria-hidden="true">⧉</span></button><a class="button" href="https://t.me/pleaserrussia" target="_blank" rel="noreferrer">Открыть Telegram ↗</a><p class="catalog-copy-status" aria-live="polite"></p></div>
        </aside>
      </section>
    </section>
    <section class="catalog-explainer section" aria-labelledby="catalog-explainer-title"><p class="eyebrow">Перед подтверждением</p><h2 id="catalog-explainer-title">Выбираем<br /><em>вместе</em></h2><div><p>Размер, доступность и посадку проверяем по конкретной паре. Если точной комбинации нет, обсудим близкие варианты или возможность пошива.</p><p>Heels Please — работаем с 2023 года. <a href="/#reviews">Почитай отзывы покупателей</a> и загляни в живой чат.</p></div></section>
  </main>
  <Footer />
  <a class="mobile-cta" href="#catalog-request">К готовому запросу ↓</a>
  <script>
    import { filterNames, fieldTitles, heightLabel, restoreFilters, catalogRoute, buildRequest, valueLabel, type FilterName, type BrandId } from "../data/catalog";
    import { trackGoal } from "../scripts/analytics";
    const form = document.querySelector<HTMLFormElement>("#catalog-filters")!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-brand]"));
    const selection = document.querySelector<HTMLElement>("#catalog-selection")!;
    const count = document.querySelector<HTMLElement>("#result-count")!;
    const request = document.querySelector<HTMLElement>("#catalog-request-text")!;
    const copy = document.querySelector<HTMLButtonElement>("#copy-catalog-request")!;
    const status = document.querySelector<HTMLElement>(".catalog-copy-status")!;
    let copyTimer: ReturnType<typeof setTimeout> | undefined;
    function update() {
      const data = new FormData(form);
      const state = restoreFilters(new URLSearchParams(filterNames.map(key => [key, String(data.get(key) || "")])));
      const params = new URLSearchParams();
      for (const key of filterNames) if (state[key]) params.set(key, state[key]);
      history.replaceState(null, "", `${location.pathname}${params.size ? `?${params}` : ""}${location.hash}`);
      const height = form.elements.namedItem("height") as HTMLSelectElement;
      for (const option of height.options) if (option.value) option.textContent = heightLabel(option.value, state.brand);
      document.querySelector<HTMLElement>("#height-help")!.textContent = state.brand === "demonia" ? "У Demonia высоту каблука и платформы уточняем по конкретной модели; танцевальные категории здесь не применяем." : "Тройки ≈ 20 см, четвёрки ≈ 23 см, пятёрки ≈ 25 см — это высота каблука. Высота платформы зависит от модели.";
      if (state.size === "help") document.querySelector<HTMLDetailsElement>("#size-help")!.open = true;
      selection.replaceChildren();
      const active = filterNames.filter(key => state[key]);
      for (const key of active) { const chip = document.createElement("span"); chip.textContent = `${fieldTitles[key]}: ${valueLabel(key, state)}`; selection.append(chip); }
      if (!active.length) selection.textContent = "Параметры пока не выбраны";
      let visible = 0;
      for (const card of cards) {
        const brand = card.dataset.brand as BrandId;
        card.hidden = Boolean(state.brand && state.brand !== brand);
        if (!card.hidden) visible++;
        const route = catalogRoute(brand, state);
        card.querySelector<HTMLAnchorElement>("[data-catalog-link]")!.href = route.url;
        const note = card.querySelector<HTMLElement>("[data-route-note]")!;
        note.replaceChildren();
        for (const [title, keys] of [["В каталоге учтено", route.applied], ["В запросе для подбора", route.pending]] as Array<[string, FilterName[]]>) {
          if (keys.length) { const p = document.createElement("p"); p.textContent = `${title}: ${keys.map(key => `${fieldTitles[key].toLowerCase()} — ${key === "height" ? heightLabel(state.height, brand) : valueLabel(key, state)}`).join("; ")}.`; note.append(p); }
        }
        if (!route.applied.length) { const p = document.createElement("p"); p.textContent = "Открывается общий или ближайший раздел бренда. Точный вариант проверим вместе."; note.prepend(p); }
      }
      count.textContent = visible === 1 ? "1 каталог" : `${visible} каталога`;
      request.textContent = buildRequest(state, { foot: String(data.get("foot") || ""), city: String(data.get("city") || ""), model: String(data.get("model") || ""), comment: String(data.get("comment") || "") });
      clearTimeout(copyTimer);
      copy.querySelector("span")!.textContent = "Скопировать запрос";
      status.textContent = "";
    }
    const restored = restoreFilters(new URLSearchParams(location.search));
    for (const key of filterNames) (form.elements.namedItem(key) as HTMLSelectElement).value = restored[key];
    if (["color", "material", "fit", "toe"].some(key => restored[key as FilterName])) document.querySelector<HTMLDetailsElement>("#additional-filters")!.open = true;
    form.addEventListener("submit", event => event.preventDefault());
    form.addEventListener("change", () => { update(); trackGoal("picker_change"); });
    form.addEventListener("input", event => { if (!(event.target instanceof HTMLSelectElement)) update(); });
    form.addEventListener("reset", () => setTimeout(() => { document.querySelector<HTMLDetailsElement>("#size-help")!.open = false; document.querySelector<HTMLDetailsElement>("#additional-filters")!.open = false; update(); }));
    copy.hidden = false;
    copy.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(request.textContent || ""); copy.querySelector("span")!.textContent = "Скопировано"; status.textContent = "Теперь открой Telegram и вставь сообщение в группе."; trackGoal("request_copy"); copyTimer = setTimeout(() => { copy.querySelector("span")!.textContent = "Скопировать запрос"; status.textContent = ""; }, 3500); }
      catch { const range = document.createRange(); range.selectNodeContents(request); const selected = window.getSelection(); selected?.removeAllRanges(); selected?.addRange(range); request.focus(); status.textContent = "Текст выделен. Скопируй его вручную и вставь в Telegram."; }
    });
    update();
    trackGoal("picker_open");
  </script>
</BaseLayout>
