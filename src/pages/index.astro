---
import { Image } from "astro:assets";
import heroImage from "../assets/pleaser.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BrandCard from "../components/BrandCard.astro";
import TelegramCta from "../components/TelegramCta.astro";
import { brands } from "../data/brands";

const title = "Стрипы Pleaser, Hella Heels и Demonia под заказ | Heels Please";
const description = "Поможем подобрать и заказать стрипы Pleaser, Hella Heels и Demonia: размер, модель, стоимость и доставка по России и в Беларусь. Консультация в Telegram.";
const keywords = [
  "стрипы Pleaser",
  "обувь для pole dance",
  "Hella Heels",
  "Demonia",
  "заказать стрипы",
  "подобрать размер стрипов",
];

const orderChecklist = `Здравствуйте! Хочу подобрать обувь:\n• Бренд:\n• Модель или ссылка:\n• Цвет:\n• Размер:\n• Длина стопы в сантиметрах:\n• Город:`;

const faqItems = [
  {
    question: "Сколько стоит обувь Pleaser, Hella Heels или Demonia?",
    answer: "Цена зависит от бренда, модели, размера, наличия и способа доставки. Пришлите менеджеру ссылку, артикул или фотографию пары — перед оформлением он рассчитает актуальную итоговую стоимость.",
  },
  {
    question: "Какие модели и цвета сейчас можно заказать?",
    answer: "Доступность меняется. Чтобы быстро получить подходящую подборку, укажите бренд, тип обуви — босоножки, ботильоны или сапоги, — желаемую высоту платформы, цвет и размер.",
  },
  {
    question: "Как подобрать размер стрипов по длине стопы?",
    answer: "Измерьте обе стопы в сантиметрах и сообщите больший результат, обычный российский размер и размер уже имеющейся обуви Pleaser или Hella Heels, если она есть. Менеджер сверит данные с таблицей и особенностями конкретной колодки.",
  },
  {
    question: "Что выбрать: босоножки, ботильоны или ботфорты?",
    answer: "Для выбора важны опыт, задача и желаемая фиксация стопы. Босоножки легче и открытее, ботильоны обычно лучше фиксируют голеностоп, а сапоги и ботфорты сильнее поддерживают ногу. Посадка также зависит от колодки и ремешков конкретной модели.",
  },
  {
    question: "Чем отличаются тройки, четвёрки и пятёрки?",
    answer: "Так в сообществе называют категории моделей по высоте платформы и каблука. Чем выше категория, тем заметнее меняются угол стопы, устойчивость и требования к опыту. Перед заказом лучше обсудить конкретную модель, а не ориентироваться только на высоту.",
  },
  {
    question: "Как понять, хорошо ли модель держит стопу?",
    answer: "Смотрите на форму колодки, угол скоса, ширину перемычки и конструкцию ремешков. Для активного танца особенно важна фиксация голеностопа. По фотографии это не всегда очевидно, поэтому попросите менеджера сравнить выбранную модель с проверенными аналогами.",
  },
  {
    question: "Можно ли заказать редкий цвет или модель, которой нет в каталоге?",
    answer: "Иногда доступен индивидуальный или коллективный пошив классических моделей. Возможность зависит от производителя. Индивидуальная пара обычно стоит дороже, а для коллективного заказа может потребоваться минимальное количество участников и полная предоплата.",
  },
  {
    question: "Сколько занимает заказ и доставка?",
    answer: "Срок зависит от наличия, бренда, страны назначения и того, нужна ли дополнительная пошивка. Менеджер сообщит ориентировочный срок вместе с итоговой стоимостью до подтверждения заказа.",
  },
  {
    question: "Можно ли заказать с доставкой в Беларусь?",
    answer: "Да, доставка в Беларусь возможна. Её актуальную стоимость и срок менеджер рассчитает по городу, модели и параметрам отправления.",
  },
  {
    question: "Как безопасно оформить заказ?",
    answer: "Оформляйте заказ только через официальный Telegram группы. Представители Heels Please не пишут покупателям первыми. Не переводите деньги аккаунтам, которые самостоятельно обратились к вам от имени магазина.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://heelsplease.ru/#organization",
      name: "Heels Please",
      url: "https://heelsplease.ru/",
      sameAs: ["https://t.me/pleaserrussia"],
    },
    {
      "@type": "WebSite",
      "@id": "https://heelsplease.ru/#website",
      url: "https://heelsplease.ru/",
      name: "Heels Please",
      alternateName: "Хилс Плиз",
      inLanguage: "ru-RU",
      publisher: { "@id": "https://heelsplease.ru/#organization" },
    },
    {
      "@type": "FAQPage",
      "@id": "https://heelsplease.ru/#faq",
      url: "https://heelsplease.ru/#faq",
      name: "Частые вопросы о выборе и заказе стрипов",
      inLanguage: "ru-RU",
      isPartOf: { "@id": "https://heelsplease.ru/#website" },
      mainEntity: faqItems.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: {
          "@type": "Answer",
          text: answer,
        },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} keywords={keywords} structuredData={structuredData}>
  <Header />
  <main id="content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">Обувь, которая продолжает движение</p>
        <h1 id="hero-title">Стрипы и<br /><em>платформы</em><br />под заказ.</h1>
        <p class="hero__intro">Pleaser, Hella Heels и Demonia — помогаем подобрать модель и размер, рассчитать стоимость и оформить доставку по России и в Беларусь.</p>
        <TelegramCta />
        <p class="hero__note">Консультация и оформление — в Telegram</p>
      </div>
      <div class="hero__visual">
        <div class="hero__frame">
          <Image
            src={heroImage}
            alt="Чёрные ботильоны Pleaser Adore-1016 на платформе и высоком каблуке"
            widths={[560, 840, 1120]}
            sizes="(max-width: 760px) 100vw, 48vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="hero__vertical">POLE · STAGE · SELF EXPRESSION</span>
        <span class="hero__edition">Selected<br />with care</span>
      </div>
      <a class="scroll-cue" href="#brands" aria-label="Перейти к брендам"><span></span>Смотреть</a>
    </section>

    <section class="marquee" aria-label="Представленные бренды">
      <div>Pleaser <span>✦</span> Hella Heels <span>✦</span> Demonia <span>✦</span> Pleaser <span>✦</span> Hella Heels <span>✦</span> Demonia</div>
    </section>

    <section class="brands section" id="brands" aria-labelledby="brands-title">
      <div class="section-heading">
        <p class="eyebrow">Три характера</p>
        <h2 id="brands-title">Выбери<br /><em>свой бренд</em></h2>
        <p>У каждого бренда — своя посадка, настроение и линейка моделей. Начни с образа, а с размером поможет менеджер.</p>
      </div>
      <div class="brands__grid">
        {brands.map((brand) => <BrandCard brand={brand} />)}
      </div>
    </section>

    <section class="guide section" id="guide" aria-labelledby="guide-title">
      <div class="guide__intro">
        <p class="eyebrow">Перед заказом</p>
        <h2 id="guide-title">Как выбрать пару,<br /><em>которая подойдёт</em></h2>
        <p>Не ориентируйся только на привычный российский размер. У разных брендов и линеек посадка отличается.</p>
      </div>
      <ol class="guide__steps">
        <li>
          <span>01</span>
          <div><h3>Определи формат</h3><p>Босоножки, ботильоны, сапоги или массивная lifestyle-платформа — под задачу и образ.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Измерь стопу</h3><p>Встань на лист бумаги, отметь крайние точки и измерь расстояние по самой длинной части в сантиметрах.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Проверь модель</h3><p>Пришли менеджеру ссылку или артикул. Он поможет сверить таблицу бренда и особенности конкретной пары.</p></div>
        </li>
      </ol>
      <aside class="guide__note">
        <strong>Важно</strong>
        <p>Таблицы размеров — ориентир, а не гарантия посадки. Финальный выбор лучше подтвердить с менеджером до заказа.</p>
      </aside>
    </section>

    <section class="brief section" aria-labelledby="brief-title">
      <div class="brief__copy">
        <p class="eyebrow">Готова к выбору?</p>
        <h2 id="brief-title">Скопируй короткий<br /><em>чек-лист</em></h2>
        <p>Заполни его и отправь в группу — так менеджер быстрее поймёт, какую пару ты ищешь.</p>
      </div>
      <div class="brief__card">
        <div class="brief__card-top"><span>Сообщение менеджеру</span><span>6 пунктов</span></div>
        <pre id="order-checklist">{orderChecklist}</pre>
        <button class="copy-button" type="button" data-copy-target="order-checklist">
          <span>Скопировать чек-лист</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 7V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2M5 8h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/></svg>
        </button>
        <p class="copy-status" aria-live="polite"></p>
      </div>
    </section>

    <section class="order section" id="order" aria-labelledby="order-title">
      <div class="order__heading">
        <p class="eyebrow">Без сложных форм</p>
        <h2 id="order-title">Как всё<br /><em>происходит</em></h2>
      </div>
      <ol class="order__steps">
        <li><span>1</span><h3>Выбираешь</h3><p>Находишь модель на сайте бренда или описываешь менеджеру, что хочется.</p></li>
        <li><span>2</span><h3>Уточняешь</h3><p>Отправляешь ссылку, размер стопы и город. Менеджер проверяет детали.</p></li>
        <li><span>3</span><h3>Подтверждаешь</h3><p>Получаешь актуальные условия, итоговую стоимость и согласовываешь заказ.</p></li>
        <li><span>4</span><h3>Остаёшься на связи</h3><p>Информация по заказу и дальнейшие вопросы остаются в Telegram.</p></li>
      </ol>
    </section>

    <section class="faq section" id="faq" aria-labelledby="faq-title">
      <div class="faq__heading">
        <div class="faq__heading-sticky">
          <p class="eyebrow">Отвечаем по делу</p>
          <h2 id="faq-title">Частые<br /><em>вопросы</em></h2>
          <p class="faq__intro">Собрали ответы по темам, которые чаще всего обсуждают перед заказом: цена, размер, посадка, наличие и доставка.</p>
          <a class="text-link" href="https://t.me/pleaserrussia" target="_blank" rel="noreferrer">Задать свой вопрос в Telegram</a>
        </div>
      </div>
      <div class="faq__list">
        {faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <span class="faq__number">{String(index + 1).padStart(2, "0")}</span>
              <span class="faq__question">{item.question}</span>
              <span class="faq__toggle" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <p class="eyebrow">Твоя следующая пара начинается здесь</p>
      <h2 id="final-title">Нашла модель?<br /><em>Напиши нам.</em></h2>
      <TelegramCta label="Перейти в Telegram" class="button--light" />
      <p>Ответим на вопросы и поможем подготовить заказ.</p>
    </section>
  </main>
  <Footer />
  <a class="mobile-cta" href="https://t.me/pleaserrussia" target="_blank" rel="noreferrer">Написать в Telegram</a>

  <script>
    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-target]");
    const copyStatus = document.querySelector<HTMLElement>(".copy-status");

    copyButton?.addEventListener("click", async () => {
      const targetId = copyButton.dataset.copyTarget;
      const text = targetId ? document.getElementById(targetId)?.textContent?.trim() : "";
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        copyButton.querySelector("span")!.textContent = "Скопировано";
        if (copyStatus) copyStatus.textContent = "Чек-лист скопирован в буфер обмена.";
        window.setTimeout(() => {
          copyButton.querySelector("span")!.textContent = "Скопировать чек-лист";
          if (copyStatus) copyStatus.textContent = "";
        }, 2500);
      } catch {
        if (copyStatus) copyStatus.textContent = "Не удалось скопировать. Выделите текст вручную.";
      }
    });
  </script>
</BaseLayout>
